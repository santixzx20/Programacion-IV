# Copiar este archivo como .env y completar con los datos reales.
# El archivo .env NO se sube al repositorio.

# ---- Base de datos PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar_por_tu_contraseña
DB_NAME=incidencias_db

# ---- Servidor ----
PORT=3000

# ---- Autenticación JWT ----
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# ---- Correo electrónico (opcional) ----
# Si no se configuran, el sistema registra el correo en consola (modo demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=gestor-incidencias@concordia.gob.ar
